      }
    },
    "settings.context.low_friction_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a break is due, wait within its timing window for a pause in recent key or pointer activity."
          }
        }
      }
    },
    "settings.context.manual_pause": {
