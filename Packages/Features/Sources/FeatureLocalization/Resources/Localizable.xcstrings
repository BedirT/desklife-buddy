    },
    "settings.evidence.visual.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A useful range, not a magic timer."
          }
        }
      }
    },
    "settings.evidence.visual.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual resets"
          }
        }
      }
    },
    "settings.evidence.visual.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The evidence supports a window, not an exact number. The 20-20-20 rule is memorable, but it is not a uniquely proven optimum."
