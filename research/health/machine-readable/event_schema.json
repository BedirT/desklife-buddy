{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local://desk-wellness/event-schema-v1",
  "title": "Legacy privacy-minimized local record envelope",
  "description": "Compatibility schema for decoding version 1.0 records only. It is not the product-fact vocabulary and must not authorize new writes. The closed ten facts and separate v2 ledgers are defined by design/machine-readable/timing_runtime_v2.yaml.",
  "x_contract_status": {
    "status": "legacy_read_only",
    "canonical_runtime_contract": "../../../design/machine-readable/timing_runtime_v2.yaml",
    "new_writes_allowed": false,
    "product_fact_mapping": {
      "opportunity_presented": "promptPresented",
      "break_started": "breakStarted",
      "timer_finished": "timerFinished",
      "user_declared_completed": "userDeclaredCompleted",
      "user_declared_already_moved": "userDeclaredAlreadyMoved",
      "position_changed": "positionChanged",
      "snoozed": "snoozed",
      "skipped": "skipped",
      "not_appropriate": "notAppropriate",
      "likely_natural_interruption": "likelyNaturalInterruption"
    },
    "separate_legacy_record_families": {
      "active_use_aggregate": "operational",
      "opportunity_scheduled": "scheduling_decision",
      "suppression_started": "operational",
      "suppression_ended": "operational",
      "subjective_checkin": "correction_or_experiment",
      "settings_changed": "operational"
    },
    "no_sensor_observation_is_completion_or_health_proof": true,
    "unknown_v1_records": "preserve_for_decode_and_exclude_from_product_fact_projection"
  },
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "recorded_at",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "active_use_aggregate",
        "opportunity_scheduled",
        "opportunity_presented",
        "break_started",
        "timer_finished",
        "user_declared_completed",
        "user_declared_already_moved",
        "position_changed",
        "snoozed",
        "skipped",
        "not_appropriate",
        "likely_natural_interruption",
        "suppression_started",
        "suppression_ended",
        "subjective_checkin",
        "settings_changed"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Stored locally; analytics should coarsen or omit exact time."
    },
    "source": {
      "enum": [
        "local_timer",
        "user",
        "system_context",
        "calendar_busy_free",
        "focus_filter",
        "companion_future"
      ]
    },
    "opportunity_type": {
      "enum": [
        "visual",
        "movement",
        "position_change",
        "recovery",
        null
      ]
    },
    "response": {
      "enum": [
        "start_5_min",
        "start_2_min",
        "done",
        "already_moved",
        "position_only",
        "snooze_5",
        "snooze_10",
        "snooze_15",
        "skip",
        "not_appropriate",
        null
      ]
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 86400
    },
    "estimated_active_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Estimate only; not sitting or gaze."
    },
    "suppression_reason": {
      "enum": [
        "manual_pause",
        "system_inactive",
        "presentation_mode",
        "focus_filter",
        "calendar_busy",
        "excluded_application",
        "outside_working_hours",
        "snooze",
        "low_friction_wait",
        null
      ]
    },
    "content_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "content_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "profile": {
      "enum": [
        "gentle",
        "balanced",
        "frequent_movement",
        "research_informed_high_frequency",
        "custom",
        null
      ]
    },
    "subjective": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "eye_comfort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "neck_shoulder_comfort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "fatigue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "usefulness": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        }
      },
      "description": "Optional local self-report; not diagnosis."
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "os_major": {
          "type": [
            "integer",
            "null"
          ]
        },
        "app_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        },
        "coarse_hour_bucket": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 23
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "subjective_checkin"
          }
        }
      },
      "then": {
        "required": [
          "subjective"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "opportunity_scheduled",
              "opportunity_presented",
              "break_started",
              "timer_finished",
              "user_declared_completed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "opportunity_type"
        ]
      }
    }
  ],
  "prohibited_fields": [
    "keystroke_content",
    "pointer_coordinates",
    "window_title",
    "url",
    "file_name",
    "calendar_title",
    "calendar_attendees",
    "calendar_notes",
    "camera_frame",
    "audio",
    "raw_healthkit_payload",
    "diagnosis",
    "employer",
    "precise_location"
  ]
}
