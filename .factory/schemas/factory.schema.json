{
  "$defs": {
    "ArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "retention_class": {
          "enum": [
            "ephemeral",
            "local-restricted",
            "sanitized-durable"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "captured_at",
        "path",
        "retention_class",
        "sha256",
        "size_bytes",
        "source_id"
      ],
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "context_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "max_changed_files": {
          "minimum": 1,
          "type": "integer"
        },
        "max_changed_lines": {
          "minimum": 1,
          "type": "integer"
        },
        "max_role_calls": {
          "minimum": 1,
          "type": "integer"
        },
        "max_tool_calls": {
          "minimum": 1,
          "type": "integer"
        },
        "max_turns": {
          "minimum": 1,
          "type": "integer"
        },
        "wall_time_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "context_bytes",
        "max_changed_files",
        "max_changed_lines",
        "max_role_calls",
        "max_tool_calls",
        "max_turns",
        "wall_time_seconds"
      ],
      "type": "object"
    },
    "ClientLaunchManifest": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "enum": [
            "claude",
            "codex",
            "pi"
          ]
        },
        "client_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "discovered_components": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "type": "array"
        },
        "environment_keys": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fallback_identity": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "minimum_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "network_policy": {
          "enum": [
            "brokered-provider-only",
            "deny-all"
          ]
        },
        "output_schema": {
          "$ref": "#/$defs/RelativePath"
        },
        "permission_mode": {
          "enum": [
            "read-only",
            "scratch-write",
            "tool-less"
          ]
        },
        "projection_root_class": {
          "const": "invocation-scratch"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "retry_policy": {
          "const": "one-structure-correction"
        },
        "selected_skill_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "tool_allowlist": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "user_root_class": {
          "const": "isolated"
        }
      },
      "required": [
        "client_id",
        "client_version",
        "discovered_components",
        "environment_keys",
        "fallback_identity",
        "minimum_version",
        "network_policy",
        "output_schema",
        "permission_mode",
        "prompt_sha256",
        "projection_root_class",
        "retry_policy",
        "selected_skill_ids",
        "timeout_seconds",
        "tool_allowlist",
        "user_root_class"
      ],
      "type": "object"
    },
    "CommandEvidence": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 1024,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "duration_milliseconds": {
          "minimum": 0,
          "type": "integer"
        },
        "environment_keys": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "exit_code": {
          "type": "integer"
        },
        "output_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "timed_out": {
          "type": "boolean"
        },
        "tool_versions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "tool_id": {
                "$ref": "#/$defs/StableId"
              },
              "version": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "tool_id",
              "version"
            ],
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "argv",
        "duration_milliseconds",
        "environment_keys",
        "exit_code",
        "output_sha256",
        "timed_out",
        "tool_versions"
      ],
      "type": "object"
    },
    "ContextPacket": {
      "additionalProperties": false,
      "properties": {
        "clean_worktree": {
          "const": true
        },
        "combined_context_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "excluded_context": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path_or_class": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "reason": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "path_or_class",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "git_head_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "included_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "minItems": 1,
          "type": "array"
        },
        "invocation_id": {
          "$ref": "#/$defs/StableId"
        },
        "issue_number": {
          "minimum": 1,
          "type": "integer"
        },
        "launch": {
          "$ref": "#/$defs/ClientLaunchManifest"
        },
        "ordered_prompt_paths": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array"
        },
        "plan_path": {
          "$ref": "#/$defs/RelativePath"
        },
        "role_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "token_estimate": {
          "minimum": 0,
          "type": "integer"
        },
        "total_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "clean_worktree",
        "combined_context_sha256",
        "contract_sha256",
        "excluded_context",
        "git_head_sha",
        "included_files",
        "invocation_id",
        "issue_number",
        "launch",
        "ordered_prompt_paths",
        "plan_path",
        "role_id",
        "schema_version",
        "token_estimate",
        "total_bytes"
      ],
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "depends_on": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "proof": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requirement": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "unproven"
        }
      },
      "required": [
        "depends_on",
        "id",
        "impacts",
        "proof",
        "requirement",
        "status"
      ],
      "type": "object"
    },
    "EvidenceManifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactEvidence"
          },
          "type": "array"
        },
        "attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "clean_worktree": {
          "const": true
        },
        "client": {
          "enum": [
            "claude",
            "codex",
            "deterministic",
            "pi"
          ]
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/CommandEvidence"
          },
          "type": "array"
        },
        "context_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "finished_at": {
          "format": "date-time",
          "type": "string"
        },
        "git_tree_oid": {
          "$ref": "#/$defs/GitSha"
        },
        "head_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "run_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "verdict_refs": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "artifacts",
        "attempt",
        "clean_worktree",
        "client",
        "commands",
        "context_sha256",
        "contract_sha256",
        "finished_at",
        "git_tree_oid",
        "head_sha",
        "model",
        "phase",
        "run_id",
        "schema_version",
        "started_at",
        "verdict_refs"
      ],
      "type": "object"
    },
    "FactoryContract": {
      "additionalProperties": false,
      "properties": {
        "accepted_at": {
          "format": "date-time",
          "type": "string"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "type": "array",
          "uniqueItems": true
        },
        "budgets": {
          "$ref": "#/$defs/Budget"
        },
        "commands": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "criteria_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "escalation": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "expected_base_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "issue_number": {
          "minimum": 1,
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "risk_tier": {
          "$ref": "#/$defs/RiskTierId"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": 1
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "allowed_paths": {
              "items": {
                "$ref": "#/$defs/RelativePath"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "allowed_tools": {
              "items": {
                "$ref": "#/$defs/StableId"
              },
              "type": "array",
              "uniqueItems": true
            },
            "excluded": {
              "items": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "included": {
              "items": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "outcome": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "allowed_paths",
            "allowed_tools",
            "excluded",
            "included",
            "outcome"
          ],
          "type": "object"
        },
        "status": {
          "const": "accepted"
        }
      },
      "required": [
        "accepted_at",
        "artifacts",
        "budgets",
        "commands",
        "contract_id",
        "contract_sha256",
        "criteria_ids",
        "escalation",
        "expected_base_sha",
        "issue_number",
        "revision",
        "risk_tier",
        "roles",
        "schema_version",
        "scope",
        "status"
      ],
      "type": "object"
    },
    "FactoryState": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "evidence_invalidated_at_generation": {
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "minimum": 0,
          "type": "integer"
        },
        "head_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "issue_number": {
          "minimum": 1,
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "pull_request_number": {
          "oneOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "resume_phase": {
          "oneOf": [
            {
              "$ref": "#/$defs/Phase"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "contract_sha256",
        "evidence_invalidated_at_generation",
        "generation",
        "head_sha",
        "issue_number",
        "phase",
        "pull_request_number",
        "resume_phase",
        "run_id",
        "schema_version"
      ],
      "type": "object"
    },
    "FeatureLedger": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "ledger_id": {
          "$ref": "#/$defs/StableId"
        },
        "product_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "active",
            "awaiting_intake",
            "retired"
          ]
        }
      },
      "required": [
        "criteria",
        "ledger_id",
        "product_revision",
        "schema_version",
        "status"
      ],
      "type": "object"
    },
    "FileDigest": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "GitSha": {
      "pattern": "^[a-f0-9]{40,64}$",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "ABORTED_OPERATOR",
        "BLOCKED_OWNER",
        "BUILDING",
        "COMPLETE",
        "CONTRACT_NEGOTIATION",
        "INTAKE_REQUIRED",
        "MERGED",
        "NEW",
        "PAUSED_OPERATOR",
        "PLANNING",
        "PR_CHECKS",
        "QUARANTINED",
        "READY_FOR_OWNER",
        "READY_TO_BUILD",
        "RECOVERING",
        "REPAIRING",
        "RETROSPECTIVE",
        "REVIEWING",
        "VERIFYING",
        "WITNESSING"
      ]
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "autonomous_start": {
          "const": "disabled_until_no_legacy_skills"
        },
        "control_plane_paths": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "agent_depth": {
              "minimum": 1,
              "type": "integer"
            },
            "max_read_only_workers": {
              "minimum": 0,
              "type": "integer"
            },
            "max_writers": {
              "const": 1
            },
            "merge_actor": {
              "const": "owner"
            },
            "merge_method": {
              "const": "rebase"
            },
            "production_mode": {
              "const": "disabled"
            },
            "repair_non_progress_cycles": {
              "minimum": 1,
              "type": "integer"
            },
            "repair_total_attempts": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "agent_depth",
            "max_read_only_workers",
            "max_writers",
            "merge_actor",
            "merge_method",
            "production_mode",
            "repair_non_progress_cycles",
            "repair_total_attempts"
          ],
          "type": "object"
        },
        "required_clients": {
          "items": {
            "enum": [
              "claude",
              "codex",
              "pi"
            ]
          },
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "risk_tiers": {
          "items": {
            "$ref": "#/$defs/RiskTier"
          },
          "minItems": 4,
          "type": "array"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "autonomous_start",
        "control_plane_paths",
        "execution",
        "required_clients",
        "risk_tiers",
        "schema_version"
      ],
      "type": "object"
    },
    "PromptRegistry": {
      "additionalProperties": false,
      "properties": {
        "roles": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "context_budget_bytes": {
                "minimum": 1,
                "type": "integer"
              },
              "id": {
                "$ref": "#/$defs/StableId"
              },
              "invalid_output_retry": {
                "const": "one-structure-correction"
              },
              "max_prompt_bytes": {
                "minimum": 1,
                "type": "integer"
              },
              "mutation_mode": {
                "enum": [
                  "proposal-only",
                  "read-only",
                  "scratch-write",
                  "tool-less"
                ]
              },
              "output_schema": {
                "pattern": "^\\.factory/schemas/[a-z-]+\\.schema\\.json#/\\$defs/[A-Za-z][A-Za-z0-9]+$",
                "type": "string"
              },
              "path": {
                "$ref": "#/$defs/RelativePath"
              },
              "preferred_provider": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/Sha256"
              },
              "size_bytes": {
                "minimum": 1,
                "type": "integer"
              },
              "tool_allowlist": {
                "items": {
                  "$ref": "#/$defs/StableId"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "context_budget_bytes",
              "id",
              "invalid_output_retry",
              "max_prompt_bytes",
              "mutation_mode",
              "output_schema",
              "path",
              "preferred_provider",
              "sha256",
              "size_bytes",
              "tool_allowlist"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "roles",
        "schema_version"
      ],
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "RiskTier": {
      "additionalProperties": false,
      "properties": {
        "command_timeout_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "context_bytes_per_role": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/RiskTierId"
        },
        "max_repair_rounds": {
          "minimum": 0,
          "type": "integer"
        },
        "max_role_calls": {
          "minimum": 1,
          "type": "integer"
        },
        "wall_time_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "command_timeout_seconds",
        "context_bytes_per_role",
        "id",
        "max_repair_rounds",
        "max_role_calls",
        "wall_time_seconds"
      ],
      "type": "object"
    },
    "RiskTierId": {
      "enum": [
        "control-plane",
        "high",
        "low",
        "medium"
      ]
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "component_exposure_refs": {
          "items": {
