{
  "$defs": {
    "ChangeDimension": {
      "enum": [
        "bug-reproduction",
        "control-plane",
        "external-design",
        "interaction-flow",
        "logic",
        "motion",
        "performance",
        "persistence",
        "privacy",
        "release",
        "ui"
      ]
    },
    "CompiledWorkflowRoute": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/ChangeDimension"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "effective_risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "policy_id": {
          "$ref": "#/$defs/StableId"
        },
        "required_evidence_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "route_id": {
          "$ref": "#/$defs/StableId"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/CompiledWorkflowStep"
          },
          "minItems": 8,
          "type": "array"
        }
      },
      "required": [
        "dimensions",
        "effective_risk",
        "policy_id",
        "required_evidence_ids",
        "route_id",
        "steps"
      ],
      "type": "object"
    },
    "CompiledWorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "dependency_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "model_lane": {
          "$ref": "#/$defs/WorkflowModelLane"
        },
        "mutation_mode": {
          "$ref": "#/$defs/WorkflowMutationMode"
        },
        "role": {
          "$ref": "#/$defs/WorkflowRole"
        }
      },
      "required": [
        "dependency_ids",
        "id",
        "model_lane",
        "mutation_mode",
        "role"
      ],
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "RiskTier": {
      "enum": [
        "control-plane",
        "high",
        "low",
        "medium"
      ]
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "WorkflowDimensionRule": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ChangeDimension"
        },
        "minimum_risk": {
          "$ref": "#/$defs/RiskTier"
        },
        "required_evidence_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required_roles": {
          "items": {
            "$ref": "#/$defs/WorkflowRole"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "dimension",
        "minimum_risk",
        "required_evidence_ids",
        "required_roles"
      ],
      "type": "object"
    },
    "WorkflowModelLane": {
      "enum": [
        "claude",
        "codex",
        "deterministic",
        "independent",
        "pi"
      ]
    },
    "WorkflowMutationMode": {
      "enum": [
        "proposal-only",
        "read-only",
        "scratch-write",
        "trusted-controller"
      ]
    },
    "WorkflowRole": {
      "enum": [
        "acceptance-author",
        "builder",
        "code-auditor",
        "contract-author",
        "contract-skeptic",
        "design-ingestor",
        "design-translator",
        "deterministic-verifier",
        "high-risk-council",
        "motion-witness",
        "performance-auditor",
        "privacy-auditor",
        "product-witness",
        "pr-shepherd",
        "release-auditor",
        "repairer"
      ]
    },
    "WorkflowRoleDefinition": {
      "additionalProperties": false,
      "properties": {
        "default_model_lane": {
          "$ref": "#/$defs/WorkflowModelLane"
        },
        "mutation_mode": {
          "$ref": "#/$defs/WorkflowMutationMode"
        },
        "role": {
          "$ref": "#/$defs/WorkflowRole"
        }
      },
      "required": [
        "default_model_lane",
        "mutation_mode",
        "role"
      ],
      "type": "object"
    },
    "WorkflowRoutePolicy": {
      "additionalProperties": false,
      "properties": {
        "common_role_order": {
          "items": {
            "$ref": "#/$defs/WorkflowRole"
          },
          "minItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "dimension_rules": {
          "items": {
            "$ref": "#/$defs/WorkflowDimensionRule"
          },
          "minItems": 11,
          "type": "array"
        },
        "policy_id": {
          "$ref": "#/$defs/StableId"
        },
        "role_definitions": {
          "items": {
            "$ref": "#/$defs/WorkflowRoleDefinition"
          },
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "common_role_order",
        "dimension_rules",
        "policy_id",
        "role_definitions"
      ],
      "type": "object"
    },
    "WorkflowRouteRequest": {
      "additionalProperties": false,
      "properties": {
        "changed_paths": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "design_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/ChangeDimension"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requested_risk": {
          "$ref": "#/$defs/RiskTier"
        }
      },
      "required": [
        "changed_paths",
        "design_source_ids",
        "dimensions",
        "requested_risk"
      ],
      "type": "object"
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/routing.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory workflow routing records"
}
