            "value": "Timer announcements"
          }
        }
      }
    },
    "settings.accessibility.timer_announcements_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether VoiceOver announces timer progress."
          }
        }
      }
    },
    "settings.break_content.breathing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include optional breathing content"
          }
        }
      }
    },
    "settings.break_content.breathing_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfortable slower breathing and sensory-reset cards may appear."
          }
        }
      }
    },
    "settings.break_content.choices": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content choices"
          }
        }
      }
    },
    "settings.break_content.library.all_cards": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All cards"
          }
        }
      }
    },
    "settings.break_content.library.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative"
          }
        }
      }
    },
    "settings.break_content.library.back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break content"
          }
        }
      }
    },
    "settings.break_content.library.browse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse library"
          }
        }
      }
    },
    "settings.break_content.library.card.b01.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60\u201390 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.b01.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe normally. If it feels comfortable, let the exhale become a little slower or longer than the inhale. No holding is needed."
          }
        }
      }
    },
    "settings.break_content.library.card.b01.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claim boundary: relaxation/reset only; no treatment claim [S039, S040]."
          }
        }
      }
    },
    "settings.break_content.library.card.b01.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfortable slower breathing"
          }
        }
      }
    },
    "settings.break_content.library.card.b01.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop if: dizzy, air-hungry, anxious, or uncomfortable."
          }
        }
      }
    },
    "settings.break_content.library.card.b02.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice three neutral things you can see, two sounds, and one physical point of support. Then return when ready."
          }
        }
      }
    },
    "settings.break_content.library.card.b02.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a generic attention reset, not therapy."
          }
        }
      }
    },
    "settings.break_content.library.card.b02.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensory reset"
          }
        }
      }
    },
    "settings.break_content.library.card.l01.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l01.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move away from the desk."
          }
        }
      }
    },
    "settings.break_content.library.card.l01.instruction.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk, wheel, or perform equivalent active movement at an easy pace."
          }
        }
      }
    },
    "settings.break_content.library.card.l01.instruction.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep breathing comfortable."
          }
        }
      }
    },
    "settings.break_content.library.card.l01.instruction.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return when the timer ends or sooner if needed."
          }
        }
      }
    },
    "settings.break_content.library.card.l01.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferred default"
          }
        }
      }
    },
    "settings.break_content.library.card.l01.internal_boundary.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the most evidence-aligned general movement card [S003\u2013S006]. It should appear more often than decorative stretch routines."
          }
        }
      }
    },
    "settings.break_content.library.card.l01.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy walk"
          }
        }
      }
    },
    "settings.break_content.library.card.l02.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l02.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutes easy walking/wheeling;"
          }
        }
      }
    },
    "settings.break_content.library.card.l02.instruction.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 minute comfortable upper-body movement;"
          }
        }
      }
    },
    "settings.break_content.library.card.l02.instruction.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 minute supported lower-leg or seated movement;"
          }
        }
      }
    },
    "settings.break_content.library.card.l02.instruction.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 minute easy walking or breathing."
          }
        }
      }
    },
    "settings.break_content.library.card.l02.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixed movement"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "march or step gently in place, or use a seated equivalent;"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.instruction.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "change direction slowly;"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.instruction.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "use a stable surface if needed;"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.instruction.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "avoid fast turning or balance challenges."
          }
        }
      }
    },
    "settings.break_content.library.card.l03.instruction_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For users who cannot leave the room:"
          }
        }
      }
    },
    "settings.break_content.library.card.l03.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small-space movement"
          }
        }
      }
    },
    "settings.break_content.library.card.l04.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "seated leg movement and forward weight shifts."
          }
        }
      }
    },
    "settings.break_content.library.card.l04.alternative_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equal alternative"
          }
        }
      }
    },
    "settings.break_content.library.card.l04.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l04.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a stable chair, stand and sit slowly a few times at a comfortable pace. Use the chair or desk for support if safe."
          }
        }
      }
    },
    "settings.break_content.library.card.l04.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit-to-stand option"
          }
        }
      }
    },
    "settings.break_content.library.card.l04.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not use if balance, pain, dizziness, recent injury/surgery, or the environment makes it unsuitable."
          }
        }
      }
    },
    "settings.break_content.library.card.l05.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "seated forward press without resistance or gentle arm movement."
          }
        }
      }
    },
    "settings.break_content.library.card.l05.alternative_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative"
          }
        }
      }
    },
    "settings.break_content.library.card.l05.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l05.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place the hands on a stable wall, step back to a comfortable angle, bend the elbows slightly, and press away. Keep the movement easy."
          }
        }
      }
    },
    "settings.break_content.library.card.l05.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No strength-treatment claim."
          }
        }
      }
    },
    "settings.break_content.library.card.l05.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall push-up option"
          }
        }
      }
    },
    "settings.break_content.library.card.l06.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "seated heel raises."
          }
        }
      }
    },
    "settings.break_content.library.card.l06.alternative_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative"
          }
        }
      }
    },
    "settings.break_content.library.card.l06.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.l06.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a stable support, rise onto the balls of the feet and lower slowly a few times."
          }
        }
      }
    },
    "settings.break_content.library.card.l06.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported calf raise"
          }
        }
      }
    },
    "settings.break_content.library.card.l06.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caution: skip if balance or foot/ankle symptoms make it unsuitable."
          }
        }
      }
    },
    "settings.break_content.library.card.m01.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "actively wheel/propel if appropriate, or combine seated marching with arm movement."
          }
        }
      }
    },
    "settings.break_content.library.card.m01.alternative_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated/wheelchair alternative"
          }
        }
      }
    },
    "settings.break_content.library.card.m01.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.m01.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step away from the desk and move at an easy, comfortable pace. A short route around the room is enough."
          }
        }
      }
    },
    "settings.break_content.library.card.m01.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk or wheel"
          }
        }
      }
    },
    "settings.break_content.library.card.m02.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.m02.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate lifting or sliding each foot for 30\u201345 seconds."
          }
        }
      }
    },
    "settings.break_content.library.card.m02.instruction.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the ankles through a comfortable range."
          }
        }
      }
    },
    "settings.break_content.library.card.m02.instruction.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach or move the arms in a way that feels easy."
          }
        }
      }
    },
    "settings.break_content.library.card.m02.instruction.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish with relaxed breathing."
          }
        }
      }
    },
    "settings.break_content.library.card.m02.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No \u201ccalorie burn\u201d or circulation-treatment claim."
          }
        }
      }
    },
    "settings.break_content.library.card.m02.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seated active reset"
          }
        }
      }
    },
    "settings.break_content.library.card.m03.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If standing is not appropriate, change seated support or orientation and perform active seated movement."
          }
        }
      }
    },
    "settings.break_content.library.card.m03.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 minutes"
          }
        }
      }
    },
    "settings.break_content.library.card.m03.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change to a different comfortable position, then move around for the rest of the timer."
          }
        }
      }
    },
    "settings.break_content.library.card.m03.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position plus movement"
          }
        }
      }
    },
    "settings.break_content.library.card.m04.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60\u201390 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.m04.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the arms hang or rest. Slowly move the shoulders forward, up, back, and down through a comfortable range. Then gently bring the shoulder blades toward each other and release."
          }
        }
      }
    },
    "settings.break_content.library.card.m04.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulder and upper-back variation"
          }
        }
      }
    },
    "settings.break_content.library.card.m04.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid forceful retraction or holding a \u201ccorrect posture.\u201d"
          }
        }
      }
    },
    "settings.break_content.library.card.m05.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "60 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.m05.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the hands relax. Open and close them gently, then move the wrists through a small comfortable range."
          }
        }
      }
    },
    "settings.break_content.library.card.m05.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No aggressive stretch or nerve-glide claims."
          }
        }
      }
    },
    "settings.break_content.library.card.m05.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand and forearm reset"
          }
        }
      }
    },
    "settings.break_content.library.card.p01.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a different comfortable chair or backrest position. You do not need to hold one position all day."
          }
        }
      }
    },
    "settings.break_content.library.card.p01.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change support"
          }
        }
      }
    },
    "settings.break_content.library.card.p02.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand if it feels comfortable and your setup is ready. Change back whenever you want."
          }
        }
      }
    },
    "settings.break_content.library.card.p02.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not prescribe a universal standing duration."
          }
        }
      }
    },
    "settings.break_content.library.card.p02.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand for a while"
          }
        }
      }
    },
    "settings.break_content.library.card.p03.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the primary task and input devices within comfortable reach. Increase text size before leaning in."
          }
        }
      }
    },
    "settings.break_content.library.card.p03.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen and reach check"
          }
        }
      }
    },
    "settings.break_content.library.card.p04.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For longer sessions, consider raising the laptop screen and using an external keyboard and pointer if available."
          }
        }
      }
    },
    "settings.break_content.library.card.p04.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Laptop setup"
          }
        }
      }
    },
    "settings.break_content.library.card.v01.alternative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "close the eyes gently for part of the timer if looking far away is not practical."
          }
        }
      }
    },
    "settings.break_content.library.card.v01.alternative_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative"
          }
        }
      }
    },
    "settings.break_content.library.card.v01.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.v01.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at something comfortably far away. Let the small details come into view without forcing focus. Blink slowly two or three times."
          }
        }
      }
    },
    "settings.break_content.library.card.v01.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not say: \u201crepair your eyes,\u201d \u201cprevent damage,\u201d or \u201cexactly 20 feet is required.\u201d"
          }
        }
      }
    },
    "settings.break_content.library.card.v01.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfortable distance"
          }
        }
      }
    },
    "settings.break_content.library.card.v02.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20\u201330 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.v02.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice one object nearby, then shift to something farther away. Repeat slowly once or twice without straining."
          }
        }
      }
    },
    "settings.break_content.library.card.v02.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near-to-far switch"
          }
        }
      }
    },
    "settings.break_content.library.card.v02.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purpose: vary visual distance."
          }
        }
      }
    },
    "settings.break_content.library.card.v02.visible_note.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caution: stop if the activity increases dizziness, double vision, or discomfort."
          }
        }
      }
    },
    "settings.break_content.library.card.v03.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15\u201320 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.v03.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relax the face. Let the eyelids close completely two or three times, without squeezing."
          }
        }
      }
    },
    "settings.break_content.library.card.v03.internal_boundary.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only as part of a normal visual break or optional blink mode."
          }
        }
      }
    },
    "settings.break_content.library.card.v03.internal_boundary.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not show every few minutes by default [S017]."
          }
        }
      }
    },
    "settings.break_content.library.card.v03.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle blink reset"
          }
        }
      }
    },
    "settings.break_content.library.card.v04.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15\u201320 seconds"
          }
        }
      }
    },
    "settings.break_content.library.card.v04.instruction.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is safe, close your eyes gently and let them rest. Keep breathing normally."
          }
        }
      }
    },
    "settings.break_content.library.card.v04.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes closed"
          }
        }
      }
    },
    "settings.break_content.library.card.v04.visible_note.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not use while walking, operating equipment, or when visual awareness is necessary."
          }
        }
      }
    },
    "settings.break_content.library.card.v05.duration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "untimed setup tip"
