{
  "$defs": {
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "accepted_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "actor": {
          "enum": [
            "domain_expert",
            "owner",
            "user"
          ]
        },
        "captured_at": {
          "format": "date-time",
          "type": "string"
        },
        "correction_id": {
          "$ref": "#/$defs/StableId"
        },
        "proposed_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": 1
        },
        "summary": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "trace_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "accepted_sha256",
        "actor",
        "captured_at",
        "correction_id",
        "proposed_sha256",
        "schema_version",
        "summary",
        "trace_id"
      ],
      "type": "object"
    },
    "EvalTarget": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "eval_target_id": {
          "$ref": "#/$defs/StableId"
        },
        "finding_id": {
          "$ref": "#/$defs/StableId"
        },
        "metric": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "public_regression_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "draft",
            "merged",
            "rejected"
          ]
        },
        "threshold": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "eval_target_id",
        "finding_id",
        "metric",
        "public_regression_id",
        "schema_version",
        "status",
        "threshold"
      ],
      "type": "object"
    },
    "ExpertDisposition": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "confirmed",
            "probable",
            "uncertain"
          ]
        },
        "correction_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "decided_at": {
          "format": "date-time",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "domain_expert",
            "owner"
          ]
        },
        "disposition": {
          "enum": [
            "actionable-defect",
            "expected-noise",
            "instrumentation-error",
            "stable-preference",
            "uncertain",
            "unsupported-capability"
          ]
        },
        "disposition_id": {
          "$ref": "#/$defs/StableId"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "confidence",
        "correction_ids",
        "decided_at",
        "decided_by",
        "disposition",
        "disposition_id",
        "rationale",
        "schema_version"
      ],
      "type": "object"
    },
    "ProductAdapterPolicy": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "disabled-by-default",
            "owner-approved-post-merge"
          ]
        },
        "automatic_mutation": {
          "const": false
        },
        "enabled": {
          "type": "boolean"
        },
        "minimum_actionable_recurrence": {
          "maximum": 100,
          "minimum": 2,
          "type": "integer"
        },
        "retention": {
          "enum": [
            "ephemeral",
            "local-restricted",
            "sanitized-durable"
          ]
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "automatic_mutation",
        "authority",
        "enabled",
        "minimum_actionable_recurrence",
        "retention",
        "schema_version"
      ],
      "type": "object"
    },
    "ProductFinding": {
      "additionalProperties": false,
      "properties": {
        "affected_surface": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "disposition_id": {
          "$ref": "#/$defs/StableId"
        },
        "eval_target_required": {
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "finding_id": {
          "$ref": "#/$defs/StableId"
        },
        "recurrence_count": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "low",
            "medium"
          ]
        },
        "status": {
          "enum": [
            "eval-target-ready",
            "noise",
            "triage-open",
            "uncertain"
          ]
        }
      },
      "required": [
        "affected_surface",
        "disposition_id",
        "eval_target_required",
        "evidence_refs",
        "finding_id",
        "recurrence_count",
        "schema_version",
        "severity",
        "status"
      ],
      "type": "object"
    },
    "ProductTrace": {
      "additionalProperties": false,
      "properties": {
        "accepted_outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/TraceValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "collected_at": {
          "format": "date-time",
          "type": "string"
        },
        "observed_action": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/TraceValue"
          },
          "minItems": 1,
          "type": "array"
        },
        "proposed_result": {
          "$ref": "#/$defs/TraceValue"
        },
        "redaction": {
          "additionalProperties": false,
          "properties": {
            "content_removed": {
              "type": "boolean"
            },
            "policy_id": {
              "$ref": "#/$defs/StableId"
            }
          },
          "required": [
            "content_removed",
            "policy_id"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": 1
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "consent": {
              "enum": [
                "contract-approved",
                "owner-imported"
              ]
            },
            "content_sha256": {
              "$ref": "#/$defs/Sha256"
            },
            "kind": {
              "enum": [
                "local-outcome",
                "manual-import",
                "structured-correction"
              ]
            },
            "provenance": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "retention_class": {
              "enum": [
                "ephemeral",
                "local-restricted",
                "sanitized-durable"
              ]
            }
          },
          "required": [
            "consent",
            "content_sha256",
            "kind",
            "provenance",
            "retention_class"
          ],
          "type": "object"
        },
        "trace_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "accepted_outcome",
        "collected_at",
        "observed_action",
        "path",
        "proposed_result",
        "redaction",
        "schema_version",
        "source",
        "trace_id"
      ],
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "TraceValue": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "summary": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "content_sha256",
        "summary"
      ],
      "type": "object"
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/product.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product records"
}
