{
  "$defs": {
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "ablation": {
          "additionalProperties": false,
          "properties": {
            "component_removed_or_changed": {
              "$ref": "#/$defs/StableId"
            },
            "outcome_changed_twice": {
              "type": "boolean"
            },
            "reproduction_refs": {
              "items": {
                "$ref": "#/$defs/RelativePath"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "component_removed_or_changed",
            "outcome_changed_twice",
            "reproduction_refs"
          ],
          "type": "object"
        },
        "attribution_id": {
          "$ref": "#/$defs/StableId"
        },
        "confidence": {
          "enum": [
            "confirmed",
            "probable",
            "suspected"
          ]
        },
        "counter_evidence_refs": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "type": "array",
          "uniqueItems": true
        },
        "incident_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "supporting_evidence_refs": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "suspect_component_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "ablation",
        "attribution_id",
        "confidence",
        "counter_evidence_refs",
        "incident_id",
        "schema_version",
        "supporting_evidence_refs",
        "suspect_component_id"
      ],
      "type": "object"
    },
    "CandidateSpec": {
      "additionalProperties": false,
      "properties": {
        "attribution_id": {
          "$ref": "#/$defs/StableId"
        },
        "base_component_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "component_id": {
          "$ref": "#/$defs/StableId"
        },
        "component_kind": {
          "enum": [
            "adapter",
            "context-route",
            "gate",
            "policy",
            "prompt",
            "rubric",
            "skill"
          ]
        },
        "hypothesis": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "max_added_context_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_changed_files": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "max_changed_lines": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "public_regression_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "candidate",
            "frozen",
            "rejected"
          ]
        },
        "trusted_base_sha": {
          "$ref": "#/$defs/GitSha"
        }
      },
      "required": [
        "attribution_id",
        "base_component_sha256",
        "candidate_id",
        "component_id",
        "component_kind",
        "hypothesis",
        "max_added_context_bytes",
        "max_changed_files",
        "max_changed_lines",
        "public_regression_id",
        "schema_version",
        "status",
        "trusted_base_sha"
      ],
      "type": "object"
    },
    "ComponentExposure": {
      "additionalProperties": false,
      "properties": {
        "blob_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "component_id": {
          "$ref": "#/$defs/StableId"
        },
        "component_kind": {
          "enum": [
            "adapter",
            "context-route",
            "gate",
            "policy",
            "prompt",
            "rubric",
            "skill"
          ]
        },
        "component_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "context_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "exposure_id": {
          "$ref": "#/$defs/StableId"
        },
        "invocation_id": {
          "$ref": "#/$defs/StableId"
        },
        "order": {
          "minimum": 0,
          "type": "integer"
        },
        "role_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "blob_sha256",
        "component_id",
        "component_kind",
        "component_version",
        "context_sha256",
        "exposure_id",
        "invocation_id",
        "order",
        "role_id",
        "schema_version"
      ],
      "type": "object"
    },
    "EvalPlan": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "confidence_requirement": {
          "maximum": 1,
          "minimum": 0.5,
          "type": "number"
        },
        "error_bound": {
          "minimum": 0,
          "type": "number"
        },
        "eval_plan_id": {
          "$ref": "#/$defs/StableId"
        },
        "independent_task_families": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "minimum_effect": {
          "type": "number"
        },
        "multiplicity_correction": {
          "enum": [
            "benjamini-hochberg",
            "bonferroni",
            "none-single-hypothesis"
          ]
        },
        "paired_repeats": {
          "minimum": 2,
          "type": "integer"
        },
        "provider_identities": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": 1
        },
        "sealed_query_budget": {
          "const": 1
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "selection_query_budget": {
          "minimum": 1,
          "type": "integer"
        },
        "sentinel_set_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "strata": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target_metric": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "candidate_id",
        "confidence_requirement",
        "error_bound",
        "eval_plan_id",
        "independent_task_families",
        "minimum_effect",
        "multiplicity_correction",
        "paired_repeats",
        "provider_identities",
        "schema_version",
        "sealed_query_budget",
        "seeds",
        "selection_query_budget",
        "sentinel_set_sha256",
        "strata",
        "target_metric"
      ],
      "type": "object"
    },
    "FactoryEpisode": {
      "additionalProperties": false,
      "properties": {
        "component_exposure_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "episode_id": {
          "$ref": "#/$defs/StableId"
        },
        "head_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "incident_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "outcome": {
          "enum": [
            "aborted-operator",
            "blocked-owner",
            "failure",
            "success"
          ]
        },
        "route_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/StableId"
        },
        "skill_exposure_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "component_exposure_ids",
        "contract_sha256",
        "episode_id",
        "head_sha",
        "incident_ids",
        "outcome",
        "route_id",
        "run_id",
        "skill_exposure_ids"
      ],
      "type": "object"
    },
    "FrozenSkillCandidate": {
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "baseline_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/SkillAtomicEdit"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "maximum_revision_rounds": {
          "const": 1
        },
        "prior_regression_id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "const": "frozen-for-evaluation"
        },
        "target_component_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "allowed_paths",
        "baseline_sha256",
        "candidate_id",
        "edits",
        "maximum_revision_rounds",
        "prior_regression_id",
        "status",
        "target_component_id"
      ],
      "type": "object"
    },
    "GitSha": {
      "pattern": "^[a-f0-9]{40,64}$",
      "type": "string"
    },
    "Incident": {
      "additionalProperties": false,
      "properties": {
        "affected_run_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "fingerprint": {
          "$ref": "#/$defs/Sha256"
        },
        "incident_id": {
          "$ref": "#/$defs/StableId"
        },
        "reproduction_state": {
          "enum": [
            "confirmed",
            "failed",
            "pending"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "signal_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "affected_run_ids",
        "evidence_refs",
        "fingerprint",
        "incident_id",
        "reproduction_state",
        "schema_version",
        "signal_ids"
      ],
      "type": "object"
    },
    "LearningSignal": {
      "additionalProperties": false,
      "properties": {
        "affected_surface": {
          "$ref": "#/$defs/StableId"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "fingerprint": {
          "$ref": "#/$defs/Sha256"
        },
        "gate_or_criterion_id": {
          "$ref": "#/$defs/StableId"
        },
        "phase": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "low",
            "medium"
          ]
        },
        "signal_id": {
          "$ref": "#/$defs/StableId"
        },
        "signal_kind": {
          "$ref": "#/$defs/StableId"
        },
        "source": {
          "enum": [
            "check",
            "escaped-defect",
            "owner-change",
            "review",
            "run-outcome"
          ]
        }
      },
      "required": [
        "affected_surface",
        "evidence_refs",
        "fingerprint",
        "gate_or_criterion_id",
        "phase",
        "schema_version",
        "severity",
        "signal_id",
        "signal_kind",
        "source"
      ],
      "type": "object"
    },
    "MonitoringRecord": {
      "additionalProperties": false,
      "properties": {
        "activated_component_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "canary_exposure_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "monitoring_id": {
          "$ref": "#/$defs/StableId"
        },
        "promotion_decision_id": {
          "$ref": "#/$defs/StableId"
        },
        "rollback_predecessor_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "activation-ready",
            "monitoring",
            "quarantined",
            "rolled-back"
          ]
        },
        "triggered_incident_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "activated_component_sha256",
        "canary_exposure_ids",
        "monitoring_id",
        "promotion_decision_id",
        "rollback_predecessor_sha256",
        "schema_version",
        "status",
        "triggered_incident_ids"
      ],
      "type": "object"
    },
    "PromotionDecision": {
      "additionalProperties": false,
      "properties": {
        "blocker_codes": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "decision": {
          "enum": [
            "probation",
            "reject"
          ]
        },
        "efficiency_passed": {
          "type": "boolean"
        },
        "promotion_decision_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "sealed_attestation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "statistical_gate_passed": {
          "type": "boolean"
        },
        "zero_critical_regressions": {
          "type": "boolean"
        }
      },
      "required": [
        "blocker_codes",
        "candidate_id",
        "decision",
        "efficiency_passed",
        "promotion_decision_id",
        "schema_version",
        "sealed_attestation_sha256",
        "statistical_gate_passed",
        "zero_critical_regressions"
      ],
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "SkillAtomicEdit": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "add",
            "delete",
            "replace"
          ]
        },
        "replacement": {
          "maxLength": 2000,
          "type": "string"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "operation",
        "replacement",
        "target"
      ],
      "type": "object"
    },
    "SkillOptAdapterPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_provider_backends": {
          "const": false
        },
        "automatic_adoption": {
          "const": false
        },
        "maximum_edits": {
          "const": 4
        },
        "package": {
          "const": "skillopt"
        },
        "package_version": {
          "const": "0.2.0"
        },
        "status": {
          "const": "build-candidate-mock-only"
        },
        "upstream_commit": {
          "const": "e4ea6a6771e797ef820cdd8bfea64c57e0481065"
        },
        "upstream_repository": {
          "const": "https://github.com/microsoft/SkillOpt"
        },
        "uv_version": {
          "const": "0.7.13"
        }
      },
      "required": [
        "allow_provider_backends",
        "automatic_adoption",
        "maximum_edits",
        "package",
        "package_version",
        "status",
        "upstream_commit",
        "upstream_repository",
        "uv_version"
      ],
      "type": "object"
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "VariantResult": {
      "additionalProperties": false,
      "properties": {
        "blocker_codes": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "revise"
          ]
        },
        "eval_plan_id": {
          "$ref": "#/$defs/StableId"
        },
        "metrics": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/StableId"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        },
        "partition": {
          "enum": [
            "public",
            "sealed",
            "selection"
          ]
        },
        "schema_version": {
          "const": 1
        },
        "variant_result_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "blocker_codes",
        "candidate_id",
        "decision",
        "eval_plan_id",
        "metrics",
        "partition",
        "schema_version",
        "variant_result_id"
      ],
      "type": "object"
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/learning.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory learning records"
}
