{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "low",
        "medium"
      ]
    },
    "DesignDeviation": {
      "additionalProperties": false,
      "properties": {
        "invariant_id": {
          "$ref": "#/$defs/StableId"
        },
        "owner_approval_required": {
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "invariant_id",
        "owner_approval_required",
        "reason"
      ],
      "type": "object"
    },
    "DesignEvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "enum": [
            "audio-timeline",
            "contact-sheet",
            "frame-set",
            "metadata",
            "render"
          ]
        },
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "provenance": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "provenance",
        "sha256"
      ],
      "type": "object"
    },
    "DesignMotionSegment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "easing": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "end_milliseconds": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "interaction_cue": {
          "oneOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "properties": {
          "items": {
            "enum": [
              "color",
              "mask",
              "opacity",
              "position",
              "rotation",
              "scale"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "reduced_motion_expectation": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "start_milliseconds": {
          "minimum": 0,
          "type": "integer"
        },
        "trajectory": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "easing",
        "end_milliseconds",
        "id",
        "interaction_cue",
        "properties",
        "reduced_motion_expectation",
        "start_milliseconds",
        "trajectory"
      ],
      "type": "object"
    },
    "DesignSourceManifest": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "video_analysis": {
                "const": null
              },
              "video_evidence_gaps": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "video_analysis": {
                    "$ref": "#/$defs/DesignVideoAnalysis"
                  },
                  "video_evidence_gaps": {
                    "maxItems": 0
                  }
                }
              },
              {
                "properties": {
                  "evidence_artifacts": {
                    "minItems": 1
                  },
                  "video_analysis": {
                    "const": null
                  },
                  "video_evidence_gaps": {
                    "minItems": 1
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "asset_paths": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "authority": {
          "enum": [
            "canonical",
            "directional",
            "native-adaptation"
          ]
        },
        "content_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "evidence_artifacts": {
          "items": {
            "$ref": "#/$defs/DesignEvidenceArtifact"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "ingestion_mode": {
          "enum": [
            "inspect-only",
            "rendered-export"
          ]
        },
        "kind": {
          "enum": [
            "asset-package",
            "figma",
            "react",
            "screenshot",
            "standalone-html",
            "video"
          ]
        },
        "origin": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "rights": {
          "enum": [
            "owner-provided",
            "repository-owned",
            "third-party-licensed"
          ]
        },
        "sensitivity": {
          "enum": [
            "private-reference",
            "public-reference",
            "repository-safe"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_version": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "state_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "video_analysis": {
          "oneOf": [
            {
              "$ref": "#/$defs/DesignVideoAnalysis"
            },
            {
              "type": "null"
            }
          ]
        },
        "video_evidence_gaps": {
          "items": {
            "$ref": "#/$defs/DesignVideoEvidenceGap"
          },
          "type": "array",
          "uniqueItems": true
        },
        "viewports": {
          "items": {
            "$ref": "#/$defs/DesignViewport"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "asset_paths",
        "authority",
        "content_sha256",
        "evidence_artifacts",
        "ingestion_mode",
        "kind",
        "origin",
        "rights",
        "sensitivity",
        "source_id",
        "source_version",
        "state_ids",
        "video_analysis",
        "video_evidence_gaps",
        "viewports"
      ],
      "type": "object"
    },
    "DesignStateMapping": {
      "additionalProperties": false,
      "properties": {
        "source_state_id": {
          "$ref": "#/$defs/StableId"
        },
        "target_preview_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "source_state_id",
        "target_preview_id"
      ],
      "type": "object"
    },
    "DesignToolIdentity": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "executable_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "executable",
        "executable_sha256",
        "version"
      ],
      "type": "object"
    },
    "DesignTranslationContract": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "deviations": {
          "items": {
            "$ref": "#/$defs/DesignDeviation"
          },
          "type": "array"
        },
        "invariant_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "route_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        },
        "state_mappings": {
          "items": {
            "$ref": "#/$defs/DesignStateMapping"
          },
          "minItems": 1,
          "type": "array"
        },
        "target_paths": {
          "items": {
            "$ref": "#/$defs/RelativePath"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "translation_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "confidence",
        "deviations",
        "invariant_ids",
        "route_id",
        "source_id",
        "state_mappings",
        "target_paths",
        "translation_id"
      ],
      "type": "object"
    },
    "DesignTranslationValidationInput": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/DesignSourceManifest"
        },
        "translation": {
          "$ref": "#/$defs/DesignTranslationContract"
        }
      },
      "required": [
        "source",
        "translation"
      ],
      "type": "object"
    },
    "DesignVideoAnalysis": {
      "additionalProperties": false,
      "properties": {
        "audio_cue_summary": {
          "oneOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_milliseconds": {
          "minimum": 1,
          "type": "integer"
        },
        "evidence_artifact_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "frame_selection_strategies": {
          "items": {
            "enum": [
              "fixed-interval",
              "scene-change",
              "visual-change"
            ]
          },
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "frames_per_second": {
          "exclusiveMinimum": 0,
          "maximum": 480,
          "type": "number"
        },
        "has_audio": {
          "type": "boolean"
        },
        "motion_segments": {
          "items": {
            "$ref": "#/$defs/DesignMotionSegment"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "pixel_height": {
          "minimum": 1,
          "type": "integer"
        },
        "pixel_width": {
          "minimum": 1,
          "type": "integer"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/DesignToolIdentity"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "audio_cue_summary",
        "duration_milliseconds",
        "evidence_artifact_ids",
        "frame_selection_strategies",
        "frames_per_second",
        "has_audio",
        "motion_segments",
        "pixel_height",
        "pixel_width",
        "tools"
      ],
      "type": "object"
    },
    "DesignVideoEvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "enum": [
            "audio-timeline",
            "frame-coverage",
            "motion-timing",
            "technical-metadata"
          ]
        }
      },
      "required": [
        "detail",
        "id",
        "kind"
      ],
      "type": "object"
    },
    "DesignViewport": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "scale": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "height",
        "id",
        "scale",
        "width"
      ],
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/design.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External design source and translation records"
}
