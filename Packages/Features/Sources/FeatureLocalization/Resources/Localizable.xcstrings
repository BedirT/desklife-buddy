    "settings.evidence.library.sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence review \u00b7 S001\u2013S080\nClaims register \u00b7 C001\u2013C050\nProduct health protocol \u00b7 sections 4\u201312"
          }
        }
      }
    },
    "settings.evidence.library.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How evidence, claims, and product decisions are separated."
          }
        }
      }
    },
    "settings.evidence.library.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source library"
          }
        }
      }
    },
    "settings.evidence.library.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source library makes decisions inspectable. It does not remove uncertainty or establish a universal schedule."
          }
        }
      }
    },
    "settings.evidence.movement.conclusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Balanced schedule offers about five minutes of easy movement around each hour, with a useful two-minute quick option."
          }
        }
      }
    },
    "settings.evidence.movement.sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement-break evidence \u00b7 S001\u2013S010"
          }
        }
      }
    },
    "settings.evidence.movement.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy movement, with more than one valid duration."
          }
        }
      }
    },
    "settings.evidence.movement.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movement"
          }
        }
      }
    },
    "settings.evidence.movement.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No single movement schedule is universally best. The more frequent schedule is an explicit higher-burden choice, not a superior outcome claim."
          }
        }
      }
    },
    "settings.evidence.overview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What shaped the defaults"
          }
        }
      }
    },
    "settings.evidence.overview_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app supports general wellness and healthier work-break routines. The evidence supports useful ranges and honest uncertainty, not one universal schedule."
          }
        }
      }
    },
    "settings.evidence.posture.conclusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app favors comfortable setup and position variation. It does not rate posture or enforce one ideal position."
          }
        }
      }
    },
    "settings.evidence.posture.sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posture and workstation evidence \u00b7 S023\u2013S032"
          }
        }
      }
    },
    "settings.evidence.posture.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfort, fit, and variation instead of policing."
          }
        }
      }
    },
    "settings.evidence.posture.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why there is no posture score"
          }
        }
      }
    },
    "settings.evidence.posture.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no universal correct posture, and intervention evidence is mixed."
          }
        }
      }
    },
    "settings.evidence.sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources"
          }
        }
      }
    },
    "settings.evidence.standing.conclusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing position can add variety. It is logged separately and never completes a movement opportunity."
          }
        }
      }
    },
    "settings.evidence.standing.sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing and movement evidence \u00b7 S011, S034"
          }
        }
      }
    },
    "settings.evidence.standing.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position change is useful context, not movement completion."
          }
        }
      }
    },
    "settings.evidence.standing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing and moving are different"
          }
        }
      }
    },
    "settings.evidence.standing.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standing reduces sitting time, but evidence for broader outcomes from standing alone remains uncertain."
          }
        }
      }
    },
    "settings.evidence.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What remains uncertain"
          }
        }
      }
    },
    "settings.evidence.visual.conclusion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default offers short visual resets within a 20\u201330 minute window of estimated active computer use."
          }
