{
  "$defs": {
    "ClientId": {
      "enum": [
        "claude",
        "codex",
        "pi"
      ]
    },
    "DesignAuthority": {
      "enum": [
        "canonical",
        "directional",
        "native-adaptation"
      ]
    },
    "FactoryDesignComparison": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/DesignAuthority"
        },
        "deviation_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "result_evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "authority",
        "deviation_ids",
        "result_evidence_id",
        "source_evidence_id",
        "source_id"
      ],
      "type": "object"
    },
    "FactoryReport": {
      "additionalProperties": false,
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/FactoryReportCriterion"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "design_comparisons": {
          "items": {
            "$ref": "#/$defs/FactoryDesignComparison"
          },
          "type": "array",
          "uniqueItems": true
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/FactoryReportEvidence"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "head_sha": {
          "$ref": "#/$defs/GitSha"
        },
        "issue_number": {
          "minimum": 1,
          "type": "integer"
        },
        "phase": {
          "enum": [
            "ABORTED_OPERATOR",
            "BLOCKED_OWNER",
            "BUILDING",
            "COMPLETE",
            "CONTRACT_NEGOTIATION",
            "INTAKE_REQUIRED",
            "MERGED",
            "NEW",
            "PAUSED_OPERATOR",
            "PLANNING",
            "PR_CHECKS",
            "QUARANTINED",
            "READY_FOR_OWNER",
            "READY_TO_BUILD",
            "RECOVERING",
            "REPAIRING",
            "RETROSPECTIVE",
            "REVIEWING",
            "VERIFYING",
            "WITNESSING"
          ]
        },
        "pull_request_number": {
          "minimum": 1,
          "type": "integer"
        },
        "qualification": {
          "enum": [
            "nonqualifying-bootstrap",
            "qualifying"
          ]
        },
        "repair_attempts": {
          "minimum": 0,
          "type": "integer"
        },
        "report_id": {
          "$ref": "#/$defs/StableId"
        },
        "risks": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role_results": {
          "items": {
            "$ref": "#/$defs/FactoryRoleResult"
          },
          "type": "array",
          "uniqueItems": true
        },
        "route_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "contract_sha256",
        "criteria",
        "design_comparisons",
        "evidence",
        "head_sha",
        "issue_number",
        "phase",
        "pull_request_number",
        "qualification",
        "repair_attempts",
        "report_id",
        "risks",
        "role_results",
        "route_id",
        "run_id"
      ],
      "type": "object"
    },
    "FactoryReportCriterion": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        }
      },
      "required": [
        "evidence_ids",
        "id",
        "status"
      ],
      "type": "object"
    },
    "FactoryReportEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "enum": [
            "accessibility",
            "build",
            "code-review",
            "motion",
            "performance",
            "test",
            "visual"
          ]
        },
        "path": {
          "$ref": "#/$defs/RelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "status"
      ],
      "type": "object"
    },
    "FactoryRoleResult": {
      "additionalProperties": false,
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientId"
        },
        "finding_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/WorkflowRole"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
        }
      },
      "required": [
        "client",
        "finding_ids",
        "role",
        "status"
      ],
      "type": "object"
    },
    "GitSha": {
      "pattern": "^[a-f0-9]{40,64}$",
      "type": "string"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "ReportStatus": {
      "enum": [
        "failed",
        "passed",
        "pending"
      ]
    },
    "Sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "WorkflowRole": {
      "enum": [
        "acceptance-author",
        "builder",
        "code-auditor",
        "contract-author",
        "contract-skeptic",
        "design-ingestor",
        "design-translator",
        "deterministic-verifier",
        "high-risk-council",
        "motion-witness",
        "performance-auditor",
        "privacy-auditor",
        "product-witness",
        "pr-shepherd",
        "release-auditor",
        "repairer"
      ]
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory owner review report"
}
