    },
    "settings.evidence.estimation.uncertainty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cannot tell whether you are sitting, standing, moving, or looking at the screen. Time away from the keyboard is not proof that you moved."
