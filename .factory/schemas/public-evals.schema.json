{
  "$defs": {
    "EvolutionAcceptance": {
      "additionalProperties": false,
      "properties": {
        "acceptance_id": {
          "$ref": "#/$defs/StableId"
        },
        "criteria": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "#/$defs/StableId"
              },
              "deterministic_predicate_ids": {
                "items": {
                  "$ref": "#/$defs/StableId"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "external_attestation_required": {
                "type": "boolean"
              },
              "id": {
                "$ref": "#/$defs/StableId"
              },
              "requirement": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "severity": {
                "enum": [
                  "critical",
                  "high"
                ]
              }
            },
            "required": [
              "category",
              "deterministic_predicate_ids",
              "external_attestation_required",
              "id",
              "requirement",
              "severity"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "decision_rule": {
          "const": "all-criteria-pass"
        },
        "forbidden_candidate_paths": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "private_epoch_binding": {
          "const": "owner-merged-before-evolution"
        },
        "public_corpus_scope": {
          "const": "visible-regressions-not-promotion"
        },
        "ruler_version": {
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "frozen-before-evolution"
        },
        "trusted_root_binding": {
          "const": "resolved-to-owner-merged-sha-at-dispatch"
        }
      },
      "required": [
        "acceptance_id",
        "criteria",
        "decision_rule",
        "forbidden_candidate_paths",
        "private_epoch_binding",
        "public_corpus_scope",
        "ruler_version",
        "schema_version",
        "trusted_root_binding",
        "status"
      ],
      "type": "object"
    },
    "PublicEvalCorpus": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "#/$defs/StableId"
              },
              "expected_decision": {
                "enum": [
                  "accept",
                  "reject"
                ]
              },
              "expected_reason_code": {
                "$ref": "#/$defs/StableId"
              },
              "fixture_id": {
                "$ref": "#/$defs/StableId"
              },
              "input_ref": {
                "$ref": "#/$defs/RelativePath"
              },
              "input_sha256": {
                "$ref": "#/$defs/Sha256"
              },
              "tags": {
                "items": {
                  "$ref": "#/$defs/StableId"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "category",
              "expected_decision",
              "expected_reason_code",
              "fixture_id",
              "input_ref",
              "input_sha256",
              "tags"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "corpus_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "const": 1
        },
        "scope": {
          "const": "public-nonqualifying"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "cases",
        "corpus_id",
        "schema_version",
        "scope",
        "version"
      ],
      "type": "object"
    },
    "RelativePath": {
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$",
      "type": "string"
    },
    "SchemaCatalog": {
      "additionalProperties": false,
      "properties": {
        "records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "fixture_path": {
                "$ref": "#/$defs/RelativePath"
              },
              "record_name": {
                "pattern": "^[A-Z][A-Za-z0-9]+$",
                "type": "string"
              },
              "schema_path": {
                "$ref": "#/$defs/RelativePath"
              },
              "schema_pointer": {
                "pattern": "^#/\\$defs/[A-Z][A-Za-z0-9]+$",
                "type": "string"
              }
            },
            "required": [
              "fixture_path",
              "record_name",
              "schema_path",
              "schema_pointer"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "records",
        "schema_version"
      ],
      "type": "object"
    },
    "SchemaFixtureSet": {
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "items": {
            "additionalProperties": false,
            "oneOf": [
              {
                "properties": {
                  "valid": {}
                },
                "required": [
                  "valid"
                ]
              },
              {
                "properties": {
                  "valid_ref": {}
                },
                "required": [
                  "valid_ref"
                ]
              }
            ],
            "properties": {
              "expected_invalid_reason": {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "invalid": {},
              "record_name": {
                "pattern": "^[A-Z][A-Za-z0-9]+$",
                "type": "string"
              },
              "schema_path": {
                "$ref": "#/$defs/RelativePath"
              },
              "schema_pointer": {
                "pattern": "^#/\\$defs/[A-Z][A-Za-z0-9]+$",
                "type": "string"
              },
              "valid": {},
              "valid_pointer": {
                "pattern": "^/.*$",
                "type": "string"
              },
              "valid_ref": {
                "$ref": "#/$defs/RelativePath"
              }
            },
            "required": [
              "expected_invalid_reason",
              "invalid",
              "record_name",
              "schema_path",
              "schema_pointer"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "fixtures",
        "schema_version"
      ],
      "type": "object"
    },
    "Sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "SkillRoutingFixture": {
      "additionalProperties": false,
      "properties": {
        "expected_selected_skill_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fixture_id": {
          "$ref": "#/$defs/StableId"
        },
        "forbidden_skill_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "confusable-negative",
            "positive"
          ]
        },
        "prompt": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "target_skill_id": {
          "$ref": "#/$defs/StableId"
        },
        "unselected_canary": {
          "oneOf": [
            {
              "pattern": "^UNSELECTED_[A-Z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expected_selected_skill_ids",
        "fixture_id",
        "forbidden_skill_id",
        "kind",
        "prompt",
        "target_skill_id",
        "unselected_canary"
      ],
      "type": "object"
    },
    "SkillRoutingFixtureSet": {
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "items": {
            "$ref": "#/$defs/SkillRoutingFixture"
          },
          "minItems": 6,
          "type": "array"
        },
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "fixtures",
        "schema_version"
      ],
      "type": "object"
    },
    "StableId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
      "type": "string"
    }
  },
  "$id": "https://swiftmac-base.invalid/schemas/public-evals.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public evaluation and Evolution acceptance records"
}
