# Project exec policy for direct repository verification commands.
# `record-snapshots.sh` is deliberately absent because it mutates baselines.

prefix_rule(pattern=["scripts/check-previews.sh"], decision="allow")
prefix_rule(pattern=["./scripts/check-previews.sh"], decision="allow")

prefix_rule(pattern=["scripts/doctor.sh"], decision="allow")
prefix_rule(pattern=["scripts/build.sh"], decision="allow")
prefix_rule(pattern=["scripts/test.sh"], decision="allow")
prefix_rule(pattern=["scripts/snapshot.sh"], decision="allow")
prefix_rule(pattern=["scripts/run.sh", "--verify"], decision="allow")
prefix_rule(pattern=["scripts/lint.sh"], decision="allow")
prefix_rule(pattern=["scripts/format.sh"], decision="allow")
prefix_rule(pattern=["scripts/new-feature.sh"], decision="allow")
prefix_rule(pattern=["scripts/verify.sh"], decision="allow")
prefix_rule(pattern=["scripts/ui.sh"], decision="allow")
prefix_rule(pattern=["scripts/shot.sh"], decision="allow")
prefix_rule(pattern=["./scripts/doctor.sh"], decision="allow")
prefix_rule(pattern=["./scripts/build.sh"], decision="allow")
prefix_rule(pattern=["./scripts/test.sh"], decision="allow")
prefix_rule(pattern=["./scripts/snapshot.sh"], decision="allow")
prefix_rule(pattern=["./scripts/run.sh", "--verify"], decision="allow")
prefix_rule(pattern=["./scripts/lint.sh"], decision="allow")
prefix_rule(pattern=["./scripts/format.sh"], decision="allow")
prefix_rule(pattern=["./scripts/new-feature.sh"], decision="allow")
prefix_rule(pattern=["./scripts/verify.sh"], decision="allow")
prefix_rule(pattern=["./scripts/ui.sh"], decision="allow")
prefix_rule(pattern=["./scripts/shot.sh"], decision="allow")
